# Managed by the portfolio installer. Do not hand-edit; use `portfolio` CLI.
server {
    listen 80;
    server_name __SERVER_NAMES__;

    client_max_body_size 25M;

    # Compress proxied HTML/JSON on the fly.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /static/ {
        alias __INSTALL_DIR__/staticfiles/;
        # WhiteNoise's Manifest storage writes content-hashed names plus .gz
        # copies: serve the .gz directly and cache for a year (names change
        # whenever the content does).
        gzip_static on;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias __INSTALL_DIR__/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass         http://127.0.0.1:__WEB_PORT__;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
